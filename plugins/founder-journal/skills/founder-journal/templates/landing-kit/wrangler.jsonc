// Landingpage als Cloudflare Worker: statische Dateien aus public/, dazu genau
// eine Route mit Code, POST /anfrage (worker/index.js), gespeichert in D1.
// Platzhalter in {{…}} beim Kopieren ersetzen (README.md, Schritt 2–4).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{WORKER_NAME}}",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/anfrage"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "{{DB_NAME}}",
      "database_id": "{{DB_ID}}",
      "migrations_dir": "migrations"
    }
  ],
  // Benachrichtigung bei Gesprächsanfragen. Das Ziel muss eine bestätigte
  // Adresse im Email Routing der Domain sein. Ohne Email Routing diesen Block
  // und NOTIFY_FROM/NOTIFY_TO weglassen; dann gibt es keine Mail.
  "send_email": [{ "name": "NOTIFY", "destination_address": "{{NOTIFY_TO}}" }],
  "vars": {
    "NOTIFY_FROM": "website@{{DOMAIN}}",
    "NOTIFY_TO": "{{NOTIFY_TO}}",
    "PRODUKT": "{{PRODUKT}}"
  },
  "observability": { "enabled": false }
}
